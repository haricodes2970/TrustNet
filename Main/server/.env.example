# TrustNet backend environment configuration.
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# Every variable in the REQUIRED section is enforced at startup by
# src/config/env.js — the process exits with a "Missing required
# environment variable(s)" message and a non-zero code if any is absent.
# Everything below that is optional and degrades gracefully when unset.

# ---------------------------------------------------------------------------
# REQUIRED — the server will not boot without these
# ---------------------------------------------------------------------------

# MongoDB connection string. A local instance or an Atlas SRV URI both work.
MONGO_URI=mongodb://127.0.0.1:27017/trustnet

# JWT signing secrets. Use long, random, DIFFERENT values per secret and per
# environment — e.g. `openssl rand -hex 32` for each. Never reuse the access
# secret as the refresh secret.
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_SECRET=replace-with-a-third-long-random-string

# Token lifetimes. Access tokens are short-lived; the refresh token lives in
# the httpOnly `trustnet_refresh` cookie and is rotated on use.
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary — file storage for avatars, project documents, and Government
# ID/KYC verification documents. KYC documents are uploaded with
# type:"authenticated" and served only via short-lived signed URLs, so these
# credentials gate access to sensitive identity documents: treat them as
# secrets and never share a production Cloudinary account with a test one.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend origin. Used for CORS and for building links in outbound email
# (password reset, verification). No trailing slash.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# OPTIONAL — server boots without these, with the noted consequence
# ---------------------------------------------------------------------------

# HTTP port (default 5000) and environment. NODE_ENV=development is the only
# mode that includes stack traces in error responses — never set it in
# production.
PORT=5000
NODE_ENV=development

# SMTP / email delivery. Without these, the OTP verification, password
# reset, and KYC decision emails are attempted and fail; the account
# actions themselves still succeed (delivery failure never blocks the
# primary action), so a tester can still register and verify by reading the
# OTP from the server logs or the database.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="TrustNet <no-reply@example.com>"

# TOTP two-factor secret encryption key. Required only to enable 2FA; with
# it unset, 2FA setup/enable is unavailable but all other auth works.
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-long-random-string

# OAuth providers. Each provider is optional and independent — omit a
# provider's block and its /auth/<provider> routes simply cannot complete.
# The redirect URI must match the value registered with the provider
# exactly, including scheme, port, and path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/auth/linkedin/callback

# Custom DNS resolvers for mongodb+srv:// SRV lookups. Only needed when the
# host's default resolver cannot answer the SRV query (a common Atlas
# connectivity failure). Comma-separated.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# No configuration is required. src/services/aiProviderService.js ships a
# deterministic built-in provider with no external API key and no network
# call, so every /api/v1/ai route works out of the box. Wiring a real LLM
# provider is a documented follow-up (see BACKLOG.md); it would add its own
# API-key variable here at that point.
